 _ROPE_STATE = RopeGlobalState()
 
 
+def restore_rope_caches_after_sleep():
+    """Restore device-side RoPE cos/sin tables from their CPU master copies.
+
+    Level-2 sleep releases the pool allocations backing full_rope_cache and
+    wake_up remaps them to zeroed pages. The tables are static content (they
+    depend only on the RoPE config, never on weights), so copying the CPU
+    masters back in place fully repairs them. The copy_() targets the existing
+    storage, keeping addresses stable for captured ACL graphs.
+    """
+    for config_key, (cpu_cos, cpu_sin) in _ROPE_STATE.cpu_master.items():
+        entry = _ROPE_STATE.full_rope_cache.get(config_key)
+        if entry is None:
+            continue
+        dev_cos, dev_sin = entry
+        dev_cos.copy_(cpu_cos)
+        dev_sin.copy_(cpu_sin)
+
