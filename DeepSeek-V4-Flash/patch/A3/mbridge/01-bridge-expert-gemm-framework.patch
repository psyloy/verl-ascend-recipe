+                name, [broad_pp_param], broad_pp_param
+            )
+        self._empty_device_cache(broad_pp_param.device)
+
+        # Every rank in every EP group all_gathers each expert block and
+        # yields the full global expert sequence, so all ranks produce an
+        # identical weight-name stream (verl relies on this: each training
+        # rank streams independently to its paired inference engine).
+        num_experts_per_rank = self.config.num_moe_experts // self.mpu.ep_size
+
+        def splice_expert_id(hf_name: str, global_expert_id: int) -> str:
+            prefix, suffix = hf_name.split(hf_experts_key, 1)
+            suffix = suffix.split(".", 1)[1]
+            return f"{prefix}{hf_experts_key}{global_expert_id}.{suffix}"
+
+        for local_expert_id, block in enumerate(
+            self._iter_gemm_local_expert_blocks(name, own_merged)
+        ):
+            if self.mpu.ep_size > 1:
