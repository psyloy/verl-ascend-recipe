+            local_slice = None
+            for rank, weight_slice in enumerate(slices):
+                weight_slice = weight_slice.to(
+                    device=param_to_load.device, dtype=param_to_load.dtype
+                ).contiguous()
+                if rank == 0:
+                    local_slice = weight_slice
+                else:
+                    torch.distributed.send(
+                        weight_slice,
