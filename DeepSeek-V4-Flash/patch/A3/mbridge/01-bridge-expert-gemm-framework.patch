+                    torch.empty_like(block) for _ in range(self.mpu.ep_size)
+                ]
+                torch.distributed.all_gather(
+                    gathered, block.contiguous(), group=self.mpu.ep_group
+                )
+            else:
+                gathered = [block]
+            for ep_rank in range(self.mpu.ep_size):
+                global_expert_id = num_experts_per_rank * ep_rank + local_expert_id
+                for hf_names, hf_weights in self._iter_gemm_export_experts(
+                    name,
+                    gathered[ep_rank],
+                    num_experts_in_tensor=1,
+                    expert_offset=local_expert_id,
+                ):
+                    converted_names = [
+                        splice_expert_id(hf_name, global_expert_id)
+                        for hf_name in hf_names
+                    ]
+                    yield from zip(converted_names, hf_weights)
+            del gathered
+            self._empty_device_cache(broad_pp_param.device)
+
+        del own_merged
+        self._empty_device_cache(broad_pp_param.device)
+        npu = getattr(torch, "npu", None)
+        if broad_pp_param.device.type == "npu" and npu is not None:
+            npu.synchronize()
