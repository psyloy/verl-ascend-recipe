+    def _export_gemm_weights(
+        self, name: str, broad_pp_param: torch.Tensor
+    ) -> Generator[tuple[str, torch.Tensor], None, None]:
+        hf_experts_key = self._get_hf_experts_key()
+        if not hf_experts_key:
+            raise RuntimeError(f"Missing HF expert key for {name}")
+
+        if self.mpu.etp_size > 1:
+            etp_params = [
+                torch.empty_like(broad_pp_param) for _ in range(self.mpu.etp_size)
+            ]
+            torch.distributed.all_gather(
+                etp_params, broad_pp_param, group=self.mpu.etp_group
+            )
