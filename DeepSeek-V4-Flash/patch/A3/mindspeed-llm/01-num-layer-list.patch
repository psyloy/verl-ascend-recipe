@@ -92,6 +92,9 @@ def get_num_layers_to_build(config: TransformerConfig) -> int:
 
     num_layer_list = config.num_layer_list
     if num_layer_list:
+        if isinstance(num_layer_list, str):
+            num_layer_list = [int(x) for x in num_layer_list.replace(';', ',').split(',') if x.strip()]
+            config.num_layer_list = num_layer_list
         pp_stage = parallel_state.get_pipeline_model_parallel_rank()
         num_layers_to_build = num_layer_list[pp_stage]
     return num_layers_to_build
@@ -117,9 +120,22 @@ def get_layer_offset_wrapper(fn):
 
     @wraps(fn)
     def wrapper(config):
-        if config.num_layer_list:
+        num_layer_list = getattr(config, 'num_layer_list', None)
+        if num_layer_list:
+            # Configs built outside megatron's argument pipeline (e.g. verl
+            # mcore_kwargs) carry num_layer_list as a raw string and never get
+            # layer_offset assigned; normalize both here.
+            if isinstance(num_layer_list, str):
+                num_layer_list = [int(x) for x in num_layer_list.replace(';', ',').split(',') if x.strip()]
+                config.num_layer_list = num_layer_list
+            layer_offset = getattr(config, 'layer_offset', None)
+            if layer_offset is None:
+                layer_offset = [0]
+                for num_layers in num_layer_list:
+                    layer_offset.append(layer_offset[-1] + num_layers)
+                config.layer_offset = layer_offset
             pp_stage = parallel_state.get_pipeline_model_parallel_rank()
-            return config.layer_offset[pp_stage]
+            return layer_offset[pp_stage]
         return fn(config)
 
     return wrapper
