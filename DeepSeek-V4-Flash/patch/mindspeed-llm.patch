diff --git a/mindspeed_llm/features_manager/pipeline_parallel/variable_seq_length_compat.py b/mindspeed_llm/features_manager/pipeline_parallel/variable_seq_length_compat.py
new file mode 100644
index 00000000..96a99c9d
--- /dev/null
+++ b/mindspeed_llm/features_manager/pipeline_parallel/variable_seq_length_compat.py
@@ -0,0 +1,40 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from argparse import Namespace
+
+from mindspeed.features_manager.feature import MindSpeedFeature
+from mindspeed.patch_utils import MindSpeedPatchesManager
+
+
+class VariableSeqLengthCompatFeature(MindSpeedFeature):
+    """Always-on: PP p2p shape protocol follows len(tensor_shape) per call.
+
+    Replaces megatron _communicate/_communicate_shapes with MindSpeed Core
+    dynamic variant, so 3D (MHC off) and 4D (MHC on, incl. V4-Pro mixed 3D/4D)
+    activations both communicate with a consistent shape protocol. Registered
+    unconditionally (optimization_level=0) because the patched implementation
+    degrades to native behavior when config.variable_seq_lengths is False, and
+    verl sets TransformerConfig.variable_seq_lengths=True unconditionally.
+    """
+
+    def __init__(self):
+        super().__init__("variable-seq-lengths-compat", optimization_level=0)
+
+    def register_patches(
+            self,
+            patch_manager: MindSpeedPatchesManager,
+            args: Namespace,
+    ):
+        # pylint: disable=import-outside-toplevel
+        from mindspeed.core.pipeline_parallel.variable_seq_length.adaptor import (
+            mindspeed_communicate,
+            mindspeed_commuticate_shapes,
+        )
+
+        patch_manager.register_patch(
+            "megatron.core.pipeline_parallel.p2p_communication._communicate",
+            mindspeed_communicate,
+        )
+        patch_manager.register_patch(
+            "megatron.core.pipeline_parallel.p2p_communication._communicate_shapes",
+            mindspeed_commuticate_shapes,
+        )

